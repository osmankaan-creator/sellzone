# ==============================================================================
# SellZone - Cloudflare & Ortam Değişkenleri Yapılandırması
# ==============================================================================

# Çalışma Ortamı (development / production)
# production modunda test demo giriş çubuğu otomatik olarak gizlenir
NODE_ENV=development
ENABLE_DEMO_USERS=false

# Sunucu Portu
PORT=3000

# Cloudflare Turnstile (Bot & DDoS Koruması)
# Cloudflare Dashboard -> Turnstile -> "Add Widget" kısmından aldığınız anahtarlar:
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Turnstile Doğrulamasını Zorunlu Kıl (true: bot doğrulaması olmadan giriş yapılamaz)
CLOUDFLARE_ENFORCE_TURNSTILE=false

# ==============================================================================
# E-Posta Gönderim (SMTP) Ayarları (Kayıt Doğrulama Kodları İçin)
# ==============================================================================
# Gmail, Outlook, Yandex, Resend veya Kurumsal Hosting SMTP bilgilerinizi buraya girin.
# (Boş bırakılırsa sistem otomatik simülasyon modunda çalışır ve kod konsola/ekrana iletilir)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SellZone
SMTP_FROM_EMAIL=noreply@sellzone.com
